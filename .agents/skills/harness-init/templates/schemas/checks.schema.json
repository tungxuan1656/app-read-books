{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness-init:v1.0:checks",
  "title": "Harness v1.0 checks",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "cwd", "quick", "requiredByDefault", "timeoutMs", "declaredEffects"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "quick": {"type": "boolean"},
          "requiredByDefault": {"type": "boolean"},
          "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 600000},
          "declaredEffects": {
            "type": "object",
            "additionalProperties": false,
            "required": ["network", "writes", "services", "installs", "secrets"],
            "properties": {
              "network": {"type": "boolean"},
              "writes": {"type": "boolean"},
              "services": {"type": "boolean"},
              "installs": {"type": "boolean"},
              "secrets": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
