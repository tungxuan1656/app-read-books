#!/usr/bin/env node

import {spawn} from 'node:child_process';
import path from 'node:path';
import {fileURLToPath} from 'node:url';

// This file is rendered by create-harness.mjs from explicit JSON argv arrays.
const START_ARGV = __START_ARGV_JSON__;
const SMOKE_ARGV = __SMOKE_ARGV_JSON__;
const READINESS_URL = __READINESS_URL_JSON__;
const READINESS_TIMEOUT_MS = 30000;
const REQUEST_TIMEOUT_MS = 2000;
const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)));
let startChild;
let startOutput = '';
let smokeOutput = '';

function assertArgv(argv, label) {
  if (!Array.isArray(argv) || argv.length === 0 || argv.some((part) => typeof part !== 'string' || part.length === 0)) {
    throw new Error(`${label} must be a non-empty argv array`);
  }
}

function append(current, chunk) {
  return current.length >= 1000000 ? current : `${current}${chunk.toString('utf8')}`.slice(0, 1000000);
}

function launch(argv, label) {
  assertArgv(argv, label);
  return new Promise((resolve) => {
    const child = spawn(argv[0], argv.slice(1), {cwd: root, shell: false, stdio: ['ignore', 'pipe', 'pipe']});
    if (label === 'start') startChild = child;
    child.stdout.on('data', (chunk) => {
      if (label === 'start') startOutput = append(startOutput, chunk);
      else smokeOutput = append(smokeOutput, chunk);
      process.stdout.write(`[${label}] ${chunk.toString()}`);
    });
    child.stderr.on('data', (chunk) => {
      if (label === 'start') startOutput = append(startOutput, chunk);
      else smokeOutput = append(smokeOutput, chunk);
      process.stderr.write(`[${label} stderr] ${chunk.toString()}`);
    });
    child.once('error', (error) => resolve({code: null, signal: null, error: error.message}));
    child.once('close', (code, signal) => resolve({code, signal}));
  });
}

const sleep = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds));

async function waitForReadiness(url) {
  if (!url) return;
  const deadline = Date.now() + READINESS_TIMEOUT_MS;
  let lastError = 'not ready';
  while (Date.now() < deadline) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
    try {
      const response = await fetch(url, {signal: controller.signal});
      if (response.ok) return;
      lastError = `HTTP ${response.status}`;
    } catch (error) {
      lastError = error.message;
    } finally {
      clearTimeout(timer);
    }
    await sleep(Math.min(250, Math.max(1, deadline - Date.now())));
  }
  throw new Error(`readiness timed out after ${READINESS_TIMEOUT_MS}ms (${lastError})`);
}

async function cleanup() {
  if (!startChild || startChild.exitCode !== null) return;
  startChild.kill('SIGTERM');
  await new Promise((resolve) => {
    const timer = setTimeout(() => {
      if (startChild.exitCode === null) startChild.kill('SIGKILL');
      resolve();
    }, 1000);
    startChild.once('close', () => {
      clearTimeout(timer);
      resolve();
    });
  });
}

async function main() {
  assertArgv(START_ARGV, 'start argv');
  assertArgv(SMOKE_ARGV, 'smoke argv');
  const startResult = launch(START_ARGV, 'start');
  await waitForReadiness(READINESS_URL);
  const smokeResult = await launch(SMOKE_ARGV, 'smoke');
  const earlyStart = await Promise.race([startResult, sleep(0).then(() => null)]);
  if (smokeResult.error || smokeResult.code !== 0) throw new Error(`smoke failed: ${smokeResult.error || `exited ${smokeResult.code ?? `by ${smokeResult.signal}`}`}`);
  if (earlyStart && (earlyStart.error || earlyStart.code !== 0)) throw new Error(`start failed: ${earlyStart.error || `exited ${earlyStart.code ?? `by ${earlyStart.signal}`}`}`);
  return 0;
}

try {
  process.exitCode = await main();
} catch (error) {
  console.error(`init failed: ${error.message}`);
  process.exitCode = 1;
} finally {
  await cleanup();
  // Keep captured output available to the process log without inventing pass evidence.
  if (startOutput.length === 0 && smokeOutput.length === 0) process.stdout.write('init completed with no child output\n');
}
