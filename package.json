{
  "name": "rn-read-books",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "scripts": {
    "start": "npx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint ./app ./components ./hooks ./services ./controllers ./utils ./constants --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint ./app ./components ./hooks ./services ./controllers ./utils ./constants --ext .js,.jsx,.ts,.tsx --fix",
    "xcode": "open ios/*.xcworkspace",
    "studio": "open -a /Applications/Android\\ Studio.app ./android/",
    "prebuild": "npx expo prebuild",
    "tsc-check": "tsc --noEmit",
    "distribute:ios": "bundle exec fastlane ios distribute",
    "distribute:android": "bundle exec fastlane android distribute"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5",
    "@react-navigation/native": "^7.1.8",
    "base-64": "^1.0.0",
    "expo": "^54.0.25",
    "expo-build-properties": "~1.0.9",
    "expo-constants": "~18.0.10",
    "expo-file-system": "~19.0.19",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.15",
    "expo-splash-screen": "~31.0.11",
    "expo-sqlite": "~16.0.9",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^3.3.0",
    "react-native-network-logger": "^2.0.1",
    "react-native-reanimated": "^4.1.2",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "4.16.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-worklets": "^0.5.1",
    "react-native-zip-archive": "^7.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "3.4.4",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/base-64": "^1.0.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.16",
    "@types/react-test-renderer": "^18.0.7",
    "babel-preset-expo": "^54.0.7",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.13",
    "prettier": "^3.8.1",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.57.2"
  },
  "private": true
}
