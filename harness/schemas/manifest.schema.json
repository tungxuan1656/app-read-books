{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness-init:v1.0:manifest",
  "title": "Harness v1.0 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "features"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mode": {"enum": ["sequential", "parallel"]},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "status", "owners", "dependsOn", "spec"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "order": {"type": "integer", "minimum": 1},
          "status": {"enum": ["proposed", "planned", "active", "blocked", "completed", "cancelled", "superseded"]},
          "owners": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "dependsOn": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "uniqueItems": true
          },
          "spec": {"type": "string", "pattern": "^docs/specs/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"}
        }
      }
    }
  }
}
